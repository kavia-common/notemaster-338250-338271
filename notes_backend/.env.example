# PostgreSQL (required for DB-backed notes)
# Provide either POSTGRES_URL (preferred) OR the individual parts below.
#
# Example (matches notes_database/db_connection.txt):
# POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
POSTGRES_HOST=localhost
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
